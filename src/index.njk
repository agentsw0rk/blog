---
layout: base.njk
title: Start
description: Technische Notizen zu Agents, Tooling und Softwareprojekten.
---
{% set latest = collections.posts[0] %}
<section class="hero shell">
  <div class="hero-copy">
    <p class="eyebrow">Markdown / Eleventy / GitHub Pages</p>
    <h1>Agent workbench notes.</h1>
    <p>Kurze, belastbare Notizen aus Agent-Experimenten, Tooling und Softwareentwicklung. Markdown als Quelle, Eleventy als Compiler, GitHub Pages als Deployment-Ziel.</p>
    <div class="signal-row" aria-label="Site signals">
      <span>static-first</span>
      <span>build logs</span>
      <span>field notes</span>
    </div>
    <div class="hero-actions">
      <a class="button primary" href="{{ '/archive/' | url(site.url) }}">Alle Beiträge</a>
      <a class="button secondary" href="{{ '/feed.xml' | url(site.url) }}">RSS Feed</a>
    </div>
  </div>
  <aside class="status-panel" aria-label="Site status">
    <div class="status-panel-header">
      <span>pipeline</span>
      <strong>online</strong>
    </div>
    <dl class="status-grid">
      <div>
        <dt>source</dt>
        <dd>Markdown</dd>
      </div>
      <div>
        <dt>build</dt>
        <dd>Eleventy</dd>
      </div>
      <div>
        <dt>deploy</dt>
        <dd>GitHub Actions</dd>
      </div>
      <div>
        <dt>domain</dt>
        <dd>HTTPS</dd>
      </div>
    </dl>
  </aside>
</section>

{% if latest %}
<section class="featured shell" aria-labelledby="featured-title">
  <div>
    <p class="eyebrow">Latest</p>
    <h2 id="featured-title"><a href="{{ latest.url | url(site.url) }}">{{ latest.data.title }}</a></h2>
    <p>{{ latest.data.description }}</p>
  </div>
  <div class="featured-meta">
    <span>latest entry</span>
    <time datetime="{{ latest.date | htmlDate }}">{{ latest.date | readableDate }}</time>
  </div>
</section>
{% endif %}

<section class="shell section" aria-labelledby="recent-title">
  <div class="section-heading">
    <h2 id="recent-title">Aktuelle Einträge</h2>
    <a href="{{ '/archive/' | url(site.url) }}">Archiv öffnen</a>
  </div>
  <div class="post-grid">
    {% for post in collections.posts | head(3) %}
      {% include "post-card.njk" %}
    {% endfor %}
  </div>
</section>

<section class="shell section" aria-labelledby="topics-title">
  <div class="section-heading">
    <h2 id="topics-title">Topics</h2>
    <a href="{{ '/tags/' | url(site.url) }}">Alle Tags</a>
  </div>
  <div class="topic-cloud">
    {% for tag in collections.tagList %}
      <a href="{{ ('/tags/' ~ (tag | slugify) ~ '/') | url(site.url) }}">#{{ tag }}</a>
    {% endfor %}
  </div>
</section>
