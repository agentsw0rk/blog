<header class="site-header">
  <div class="shell nav">
    <a class="brand" href="{{ '/' | url(site.url) }}" aria-label="{{ site.title }} Startseite">
      <span class="brand-mark">a0</span>
      <span class="brand-name">
        <pre class="ansi-logo brand-ansi-logo" data-ansi-logo aria-hidden="true">{{ site.title }}</pre>
        <span>agent notes / build logs</span>
      </span>
    </a>
    <nav class="nav-links" aria-label="Hauptnavigation">
      {% for item in site.nav %}
        <a href="{{ item.url | url(site.url) }}" data-nav-link>{{ item.label }}</a>
      {% endfor %}
      <a class="nav-github" href="{{ site.github }}">GitHub</a>
    </nav>
  </div>
</header>
