<header class="site-header">
  <div class="shell nav">
    <a class="brand" href="{{ '/' | url(site.url) }}" aria-label="{{ site.title }} Startseite">
      <span class="brand-mark">a0</span>
      <span class="brand-name">
        <pre class="ansi-logo brand-ansi-logo" data-ansi-logo aria-hidden="true">{{ site.title }}</pre>
      </span>
    </a>
    <nav class="nav-links" aria-label="Hauptnavigation">
      {% for item in site.nav %}
        {% set href = item.url %}
        {% if not item.external %}
          {% set href = item.url | url(site.url) %}
        {% endif %}
        <a
          {% if item.variant %}class="nav-link-{{ item.variant }}"{% endif %}
          href="{{ href }}"
          {% if not item.external %}data-nav-link{% endif %}
          {% if item.external %}aria-label="{{ item.label }}: repobridge öffnen"{% endif %}
        >{{ item.label }}</a>
      {% endfor %}
    </nav>
  </div>
</header>
