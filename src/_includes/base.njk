<!doctype html>
<html lang="{{ site.language }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description or site.description }}">
    <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ '/feed.xml' | url(site.url) }}">
    <link rel="stylesheet" href="{{ '/assets/css/main.css' | url(site.url) }}">
    <script src="{{ '/assets/js/main.js' | url(site.url) }}" defer></script>
  </head>
  <body>
    {% include "header.njk" %}
    <main id="main-content">
      {{ content | safe }}
    </main>
    {% include "footer.njk" %}
  </body>
</html>
