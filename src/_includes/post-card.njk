<article class="post-card">
  <p class="post-card-meta"><time datetime="{{ post.date | htmlDate }}">{{ post.date | readableDate }}</time></p>
  <h3><a href="{{ post.url | url(site.url) }}">{{ post.data.title }}</a></h3>
  <p>{{ post.data.description }}</p>
  <div class="tag-row" aria-label="Tags">
    {% for tag in post.data.tags %}
      {% if tag != "post" %}
        <a href="{{ ('/tags/' ~ (tag | slugify) ~ '/') | url(site.url) }}">#{{ tag }}</a>
      {% endif %}
    {% endfor %}
  </div>
</article>
